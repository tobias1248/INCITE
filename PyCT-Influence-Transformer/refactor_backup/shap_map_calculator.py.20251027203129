import argparse
import time
from pathlib import Path
from typing import Optional, Sequence


def parse_args(argv: Optional[Sequence[str]] = None) -> argparse.Namespace:
    """Parse CLI arguments for SHAP map calculation workflow."""
    parser = argparse.ArgumentParser(
        description="Compute SHAP value maps for transformer experiments."
    )
    parser.add_argument(
        "--model-name",
        default="transformer_fashion_mnist",
        help="Model identifier used to locate weights and SHAP artifacts.",
    )
    parser.add_argument(
        "--first-n",
        type=int,
        default=100,
        help="Number of inputs (starting from index 0) to process.",
    )
    parser.add_argument(
        "--explainer-type",
        choices=("gradient", "kernel"),
        default="gradient",
        help="SHAP explainer implementation to use.",
    )
    parser.add_argument(
        "--output-root",
        default="shap_value_all_layer",
        help="Root directory where SHAP JSON outputs are stored.",
    )
    parser.add_argument(
        "--force-refresh",
        action="store_true",
        help="Recompute SHAP even if cached results already exist.",
    )
    parser.add_argument(
        "--sleep-seconds",
        type=float,
        default=3.0,
        help="Optional delay before processing inputs.",
    )
    return parser.parse_args(argv)


def _resolve_output_dir(root: str, model_name: str) -> Path:
    """Create and return the output directory for storing SHAP artifacts."""
    output_dir = Path(root) / model_name
    output_dir.mkdir(parents=True, exist_ok=True)
    return output_dir


def main(argv: Optional[Sequence[str]] = None) -> None:
    """CLI entry point for generating SHAP maps."""
    args = parse_args(argv)

    if args.first_n < 1:
        raise ValueError("--first-n must be >= 1")
    if args.sleep_seconds < 0:
        raise ValueError("--sleep-seconds must be non-negative")

    # Import heavy dependencies lazily to keep startup fast.
    from utils.pyct_attack_exp_research_question import (
        fashion_mnist_transformer_shap_calculate_all,
    )
    from libct.shapInfl import ShapValuesComparator

    inputs, _ = fashion_mnist_transformer_shap_calculate_all(
        args.model_name, first_n_img=args.first_n
    )
    print("#" * 40, f"number of inputs: {len(inputs)}", "#" * 45)

    if args.sleep_seconds:
        time.sleep(args.sleep_seconds)

    output_dir = _resolve_output_dir(args.output_root, args.model_name)

    for input_dict in inputs:
        idx = input_dict["idx"]
        shap_path = output_dir / f"shap_value_{idx}.json"
        has_cache = shap_path.exists()

        if has_cache and not args.force_refresh:
            print(f"[SKIP] SHAP already exists for idx={idx}")
            continue

        status = "Overwriting" if has_cache else "Calculating"
        print(f"[{status.upper()}] SHAP for idx={idx}")

        ShapValuesComparator(
            model_path=f"./model/{args.model_name}.h5",
            background_dataset=input_dict["background_dataset_for_shap"],
            input=input_dict["input_for_shap"],
            idx=idx,
            shap_value_pre_calculated=has_cache and not args.force_refresh,
            explainer_type=args.explainer_type,
        )

    print("✅ All SHAP calculations completed.")


if __name__ == "__main__":
    main()
